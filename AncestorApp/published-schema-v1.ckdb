DEFINE SCHEMA

    RECORD TYPE publishedLifeEvents (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        id ENCRYPTED STRING,
        personID ENCRYPTED STRING,
        schemaVersion ENCRYPTED INT64,
        kindRaw ENCRYPTED STRING,
        dateOriginal ENCRYPTED STRING,
        dateEarliest ENCRYPTED INT64,
        dateLatest ENCRYPTED INT64,
        dateQualifierRaw ENCRYPTED STRING,
        dateIsApproximate ENCRYPTED INT64,
        location ENCRYPTED STRING,
        detailsJSON ENCRYPTED STRING,
        sourceURL ENCRYPTED STRING,
        checksum ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_personID ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_schemaVersion ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_kindRaw ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_dateOriginal ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_dateEarliest ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_dateLatest ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_dateQualifierRaw ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_dateIsApproximate ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_location ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_detailsJSON ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_sourceURL ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_checksum ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE publishedManifests (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        id ENCRYPTED STRING,
        schemaVersion ENCRYPTED INT64,
        generation ENCRYPTED INT64,
        rootPerson ENCRYPTED STRING,
        personCount ENCRYPTED INT64,
        relationshipCount ENCRYPTED INT64,
        publishedAtISO ENCRYPTED STRING,
        checksum ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_schemaVersion ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_generation ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_rootPerson ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_personCount ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_relationshipCount ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_publishedAtISO ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_checksum ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE publishedMedia (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        id ENCRYPTED STRING,
        personID ENCRYPTED STRING,
        schemaVersion ENCRYPTED INT64,
        kind ENCRYPTED STRING,
        caption ENCRYPTED STRING,
        relativePath ENCRYPTED STRING,
        asset ASSET,
        checksum ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_personID ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_schemaVersion ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_kind ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_caption ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_relativePath ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_asset ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_checksum ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE publishedPersons (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        id ENCRYPTED STRING,
        manifestID ENCRYPTED STRING,
        schemaVersion ENCRYPTED INT64,
        displayName ENCRYPTED STRING,
        givenName ENCRYPTED STRING,
        familyName ENCRYPTED STRING,
        genderRaw ENCRYPTED STRING,
        birthOriginal ENCRYPTED STRING,
        birthEarliest ENCRYPTED INT64,
        birthLatest ENCRYPTED INT64,
        birthQualifierRaw ENCRYPTED STRING,
        birthIsApproximate ENCRYPTED INT64,
        birthPlace ENCRYPTED STRING,
        deathOriginal ENCRYPTED STRING,
        deathEarliest ENCRYPTED INT64,
        deathLatest ENCRYPTED INT64,
        deathQualifierRaw ENCRYPTED STRING,
        deathIsApproximate ENCRYPTED INT64,
        deathPlace ENCRYPTED STRING,
        bioText ENCRYPTED STRING,
        citationsJSON ENCRYPTED STRING,
        badgesJSON ENCRYPTED STRING,
        isRedacted ENCRYPTED INT64,
        isProvisional ENCRYPTED INT64,
        checksum ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_manifestID ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_schemaVersion ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_displayName ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_givenName ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_familyName ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_genderRaw ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_birthOriginal ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_birthEarliest ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_birthLatest ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_birthQualifierRaw ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_birthIsApproximate ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_birthPlace ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_deathOriginal ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_deathEarliest ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_deathLatest ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_deathQualifierRaw ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_deathIsApproximate ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_deathPlace ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_bioText ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_citationsJSON ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_badgesJSON ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_isRedacted ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_isProvisional ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_checksum ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE publishedRelationships (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        id ENCRYPTED STRING,
        fromPersonID ENCRYPTED STRING,
        toPersonID ENCRYPTED STRING,
        schemaVersion ENCRYPTED INT64,
        typeRaw ENCRYPTED STRING,
        roleRaw ENCRYPTED STRING,
        subtypeRaw ENCRYPTED STRING,
        marriageOriginal ENCRYPTED STRING,
        marriageEarliest ENCRYPTED INT64,
        marriageLatest ENCRYPTED INT64,
        marriageQualifierRaw ENCRYPTED STRING,
        marriageIsApproximate ENCRYPTED INT64,
        marriageLocation ENCRYPTED STRING,
        divorceOriginal ENCRYPTED STRING,
        divorceEarliest ENCRYPTED INT64,
        divorceLatest ENCRYPTED INT64,
        divorceQualifierRaw ENCRYPTED STRING,
        divorceIsApproximate ENCRYPTED INT64,
        checksum ENCRYPTED STRING,
        sqlitedata_icloud_userModificationTime ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_id ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_fromPersonID ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_toPersonID ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_schemaVersion ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_typeRaw ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_roleRaw ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_subtypeRaw ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_marriageOriginal ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_marriageEarliest ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_marriageLatest ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_marriageQualifierRaw ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_marriageIsApproximate ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_marriageLocation ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_divorceOriginal ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_divorceEarliest ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_divorceLatest ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_divorceQualifierRaw ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_divorceIsApproximate ENCRYPTED INT64,
        sqlitedata_icloud_userModificationTime_checksum ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
