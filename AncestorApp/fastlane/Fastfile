default_platform(:mac)

platform :mac do
  desc "Build the app"
  lane :build do
    Dir.chdir("..") do
      sh("swift build -c release")
    end
  end

  desc "Run tests"
  lane :test do
    Dir.chdir("..") do
      sh("swift test")
    end
  end

  desc "Archive and upload to App Store Connect"
  lane :release do
    # Build archive
    Dir.chdir("..") do
      sh("xcodebuild archive",
         "-scheme AncestorApp",
         "-archivePath build/AncestorApp.xcarchive",
         "-destination 'generic/platform=macOS'",
         "CODE_SIGN_IDENTITY='Apple Development'",
         "DEVELOPMENT_TEAM='#{ENV['DEVELOPMENT_TEAM']}'",
         "PRODUCT_BUNDLE_IDENTIFIER='#{ENV['BUNDLE_ID'] || 'com.darrylcauldwell.ancestor-research'}'")
    end

    # Export for App Store
    Dir.chdir("..") do
      sh("xcodebuild -exportArchive",
         "-archivePath build/AncestorApp.xcarchive",
         "-exportPath build/export",
         "-exportOptionsPlist fastlane/ExportOptions.plist")
    end

    # Upload to App Store Connect
    upload_to_app_store(
      app_identifier: ENV['BUNDLE_ID'] || 'com.darrylcauldwell.ancestor-research',
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      pkg: "build/export/AncestorApp.pkg"
    )
  end
end
