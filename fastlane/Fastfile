# Fastfile for Ancestor Research

default_platform(:mac)

# Shared helper — builds an App Store Connect API key from environment variables.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH")
  )
end

platform :mac do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    api_key = asc_api_key

    # Fetch latest build number from TestFlight and increment
    begin
      latest_build = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: "dev.dreamfold.Ancestor-Research",
        platform: "osx"
      )
    rescue => e
      UI.message("No existing TestFlight builds found — starting at 1")
      latest_build = 0
    end
    new_build = latest_build + 1

    # Set build number using agvtool (Apple Generic Versioning)
    increment_build_number(
      xcodeproj: "Ancestor Research.xcodeproj",
      build_number: new_build
    )

    increment_version_number(
      xcodeproj: "Ancestor Research.xcodeproj",
      version_number: "1.0"
    )

    asc_key_id = ENV.fetch("ASC_KEY_ID")
    asc_issuer_id = ENV.fetch("ASC_ISSUER_ID")
    asc_key_path = ENV.fetch("ASC_KEY_PATH")

    # Build the app
    build_app(
      scheme: "Ancestor Research",
      export_method: "app-store",
      project: "Ancestor Research.xcodeproj",
      destination: "generic/platform=macOS",
      xcargs: "-skipMacroValidation -allowProvisioningUpdates -authenticationKeyPath '#{File.expand_path(asc_key_path)}' -authenticationKeyID #{asc_key_id} -authenticationKeyIssuerID #{asc_issuer_id}",
      export_options: {
        signingStyle: "automatic",
        teamID: "N6BK2WX94Z"
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload metadata and screenshots to App Store Connect"
  lane :metadata do
    api_key = asc_api_key
    deliver(
      api_key: api_key,
      app_identifier: "dev.dreamfold.Ancestor-Research",
      skip_binary_upload: true,
      skip_screenshots: false,
      force: true,
      platform: "osx",
      app_rating_config_path: "fastlane/rating_config.json",
      precheck_include_in_app_purchases: false
    )
  end

  desc "Submit existing TestFlight build to App Store review"
  lane :promote do
    api_key = asc_api_key
    build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "dev.dreamfold.Ancestor-Research",
      platform: "osx"
    )
    deliver(
      api_key: api_key,
      app_identifier: "dev.dreamfold.Ancestor-Research",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      force: true,
      platform: "osx",
      build_number: build.to_s,
      app_version: "1.0",
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      }
    )
  end

  desc "Build and archive without uploading"
  lane :build do
    build_app(
      scheme: "Ancestor Research",
      export_method: "app-store",
      project: "Ancestor Research.xcodeproj",
      destination: "generic/platform=macOS",
      xcargs: "-skipMacroValidation"
    )
  end

  desc "Run tests"
  lane :test do
    run_tests(
      scheme: "Ancestor Research Tests",
      project: "Ancestor Research.xcodeproj",
      destination: "platform=macOS",
      xcargs: "-skipMacroValidation"
    )
  end
end
