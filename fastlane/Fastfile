# Fastfile for Ancestor Research

default_platform(:mac)

# Shared helper — builds an App Store Connect API key from environment variables.
def asc_api_key
  asc_key_id = ENV.fetch("ASC_KEY_ID")
  asc_issuer_id = ENV.fetch("ASC_ISSUER_ID")
  asc_key_path = ENV.fetch("ASC_KEY_PATH")

  app_store_connect_api_key(
    key_id: asc_key_id,
    issuer_id: asc_issuer_id,
    key_filepath: asc_key_path
  )
end

platform :mac do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    api_key = asc_api_key

    # Fetch latest build number from TestFlight and increment
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "dev.dreamfold.Ancestor-Research",
      platform: "osx"
    )
    new_build = latest_build + 1

    increment_build_number(
      xcodeproj: "Ancestor Research.xcodeproj",
      build_number: new_build
    )

    increment_version_number(
      xcodeproj: "Ancestor Research.xcodeproj",
      version_number: "1.0"
    )

    asc_key_id = ENV.fetch("ASC_KEY_ID")
    asc_issuer_id = ENV.fetch("ASC_ISSUER_ID")
    asc_key_path = ENV.fetch("ASC_KEY_PATH")

    # Build the app
    build_app(
      scheme: "Ancestor Research",
      export_method: "app-store",
      project: "Ancestor Research.xcodeproj",
      destination: "generic/platform=macOS",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath '#{File.expand_path(asc_key_path)}' -authenticationKeyID #{asc_key_id} -authenticationKeyIssuerID #{asc_issuer_id}",
      export_options: {
        signingStyle: "automatic",
        teamID: "N6BK2WX94Z"
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and archive without uploading"
  lane :build do
    build_app(
      scheme: "Ancestor Research",
      export_method: "app-store",
      project: "Ancestor Research.xcodeproj",
      destination: "generic/platform=macOS"
    )
  end

  desc "Run tests"
  lane :test do
    run_tests(
      scheme: "Ancestor Research",
      project: "Ancestor Research.xcodeproj",
      destination: "platform=macOS"
    )
  end
end
